generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // Force CommonJS client output so the built files run under Node CJS
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id              String   @id @default(uuid())
  businessName    String
  businessType    String
  defaultCurrency String
  logo            String?
  receiptFooter   String?
  email           String?
  phone           String?
  taxEnabled      Boolean  @default(false)
  taxRate         Decimal?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branches             Branch[]
  memberships          BusinessMembership[]
  receipts             Receipt[]
  customers            Customer[]
  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]
}

model Branch {
  id                String   @id @default(uuid())
  branchName        String
  address           String?
  city              String?
  stateOrProvince   String?
  country           String
  phone             String?
  receiptPrefix     String   @default("RCP")
  nextReceiptNumber Int      @default(1)
  isMainBranch      Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  employeeAssignments BranchAssignment[]
  receipts            Receipt[]
}

enum BusinessRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                   BusinessMembership[]
  authSessions                  AuthSession[]
  createdReceipts               Receipt[]
  createdCustomers              Customer[]
  voidedReceipts                Receipt[]             @relation("VoidedReceipts")
  correctedReceipts             Receipt[]             @relation("CorrectedByUser")
  initiatedSubscriptionPayments SubscriptionPayment[] @relation("SubscriptionPaymentsInitiatedBy")
}

model BusinessMembership {
  id        String           @id @default(uuid())
  role      BusinessRole
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  branchAssignments BranchAssignment[]

  @@unique([userId, businessId])
}

model Customer {
  id              String  @id @default(cuid())
  businessId      String
  createdByUserId String?

  fullName String?
  phone    String?
  email    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdByUser User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  receipts Receipt[]

  @@index([businessId])
  @@index([createdByUserId])
  @@index([businessId, fullName])
  @@index([businessId, phone])
  @@index([businessId, email])
}

model BranchAssignment {
  id         String   @id @default(uuid())
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  membershipId String
  membership   BusinessMembership @relation(fields: [membershipId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([membershipId, branchId])
}

model AuthSession {
  id               String    @id @default(uuid())
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ReceiptStatus {
  ISSUED
  VOIDED
  CORRECTED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}

model Receipt {
  id               String @id @default(uuid())
  receiptNumber    String
  verificationCode String @unique

  customerName  String?
  customerPhone String?
  customerEmail String?
  customerId    String?

  currency      String
  subtotal      Decimal
  discountTotal Decimal       @default(0)
  taxTotal      Decimal       @default(0)
  grandTotal    Decimal
  paymentMethod PaymentMethod
  notes         String?

  status ReceiptStatus @default(ISSUED)

  voidedAt   DateTime?
  voidReason String?

  voidedByUserId String?
  voidedByUser   User?   @relation("VoidedReceipts", fields: [voidedByUserId], references: [id])

  correctedAt      DateTime?
  correctionReason String?

  correctedByUserId String?
  correctedByUser   User?   @relation("CorrectedByUser", fields: [correctedByUserId], references: [id])

  originalReceiptId String?
  originalReceipt   Receipt? @relation("ReceiptCorrections", fields: [originalReceiptId], references: [id])

  replacementReceipts Receipt[] @relation("ReceiptCorrections")

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdByUserId String
  createdByUser   User   @relation(fields: [createdByUserId], references: [id])

  items ReceiptItem[]

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([branchId, receiptNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([createdByUserId])
  @@index([voidedByUserId])
  @@index([correctedByUserId])
  @@index([originalReceiptId])
  @@index([issuedAt])
  @@index([customerId])
}

model ReceiptItem {
  id             String   @id @default(uuid())
  description    String
  quantity       Decimal
  unitPrice      Decimal
  discountAmount Decimal  @default(0)
  taxRate        Decimal  @default(0)
  taxAmount      Decimal  @default(0)
  lineSubtotal   Decimal
  lineTotal      Decimal
  createdAt      DateTime @default(now())

  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

/// =====================================================
// SUBSCRIPTIONS
// =====================================================

enum SubscriptionPlan {
  FREE
  STARTER
  BUSINESS
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SubscriptionBillingPeriod {
  MONTHLY
  ANNUAL
}

enum SubscriptionPaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  PAYUNIT
  PAYSTACK
  STRIPE
  DLOCAL
  FLUTTERWAVE
}

model Subscription {
  id     String             @id @default(uuid())
  plan   SubscriptionPlan   @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  scheduledPlan   SubscriptionPlan?
  scheduledPlanAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  payments SubscriptionPayment[]
}

model SubscriptionPayment {
  id String @id @default(uuid())

  reference String @unique

  plan          SubscriptionPlan
  billingPeriod SubscriptionBillingPeriod

  amount   Decimal
  currency String

  provider PaymentProvider

  status SubscriptionPaymentStatus @default(PENDING)

  providerTransactionId String?
  providerReference     String?
  checkoutUrl           String?
  failureReason         String?

  paidAt    DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  initiatedByUserId String?
  initiatedByUser   User?   @relation("SubscriptionPaymentsInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([subscriptionId])
  @@index([initiatedByUserId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
  @@index([providerTransactionId])
}
