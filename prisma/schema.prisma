generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // Force CommonJS client output so the built files run under Node CJS
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id              String   @id @default(uuid())
  businessName    String
  businessType    String
  defaultCurrency String
  logo            String?
  email           String?
  phone           String?
  taxEnabled      Boolean  @default(false)
  taxRate         Decimal?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branches     Branch[]
  memberships  BusinessMembership[]
  authSessions AuthSession[]
}

model Branch {
  id                String   @id @default(uuid())
  branchName        String
  address           String?
  city              String?
  stateOrProvince   String?
  country           String
  phone             String?
  receiptPrefix     String   @default("RCP")
  nextReceiptNumber Int      @default(1)
  isMainBranch      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  employeeAssignments BranchAssignment[]
}

enum BusinessRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  BusinessMembership[]
  authSessions AuthSession[]
}

model BusinessMembership {
  id        String           @id @default(uuid())
  role      BusinessRole
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  branchAssignments BranchAssignment[]

  @@unique([userId, businessId])
}

model BranchAssignment {
  id         String   @id @default(uuid())
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  membershipId String
  membership   BusinessMembership @relation(fields: [membershipId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([membershipId, branchId])
}

model AuthSession {
  id               String    @id @default(uuid())
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business? @relation(fields: [businessId], references: [id])
  businessId String?

  @@index([userId])
  @@index([expiresAt])
}
